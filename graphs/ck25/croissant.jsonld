{
  "@context": {
    "@vocab": "https://mlcommons.org/croissant/",
    "dct": "http://purl.org/dc/terms/",
    "schema": "http://schema.org/",
    "sc": "http://schema.org/"
  },
  "@type": "Dataset",
  "@id": "https://text2sparql.aksw.org/2025/corporate/",
  "name": "TEXT2SPARQL Benchmark — Corporate Knowledge Graph",
  "description": "RDF benchmark dataset for text-to-SPARQL systems, structured as a VoID dataset with modular imports for instances, vocabularies, shapes, examples, and query workloads.",
  "license": "https://creativecommons.org/licenses/by/4.0/",

  "distribution": [
    { "@type": "FileObject", "@id": "entrypoint", "name": "ck25.ttl", "contentUrl": "ck25.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "entrypoint-graph", "name": "ck25.graph", "contentUrl": "ck25.graph", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "instances", "name": "ck25-data-instances.ttl", "contentUrl": "ck25-data-instances.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "instances-graph", "name": "ck25-data-instances.graph", "contentUrl": "ck25-data-instances.graph", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "vocab", "name": "ck25-data-vocab.ttl", "contentUrl": "ck25-data-vocab.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "vocab-graph", "name": "ck25-data-vocab.graph", "contentUrl": "ck25-data-vocab.graph", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "shapes", "name": "ck25-data-shapes.ttl", "contentUrl": "ck25-data-shapes.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "shapes-graph", "name": "ck25-data-shapes.graph", "contentUrl": "ck25-data-shapes.graph", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "examples", "name": "ck25-examples.ttl", "contentUrl": "ck25-examples.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "examples-graph", "name": "ck25-examples.graph", "contentUrl": "ck25-examples.graph", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "queries", "name": "ck25-queries.ttl", "contentUrl": "ck25-queries.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "queries-graph", "name": "ck25-queries.graph", "contentUrl": "ck25-queries.graph", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "void", "name": "ck25-void.ttl", "contentUrl": "ck25-void.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "void-graph", "name": "ck25-void.graph", "contentUrl": "ck25-void.graph", "encodingFormat": "application/octet-stream" }
  ],

  "recordSet": [
    {
      "@type": "RecordSet",
      "name": "Query Benchmark",
      "field": [
        { "@type": "Field", "name": "question", "dataType": "sc:Text", "source": { "fileObject": "queries" } },
        { "@type": "Field", "name": "sparql_query", "dataType": "sc:Text", "source": { "fileObject": "queries" } }
      ]
    }
  ]
}