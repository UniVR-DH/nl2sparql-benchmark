:27 a lsqv:Query ;
  rdfs:label "Give me a phone directory of everyone on staff who does not manage anyone, I need name, email, and phone, sorted by name?" ;
  dct:created "2026-03-30T16:02:31.732700Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.732700Z"^^xsd:dateTime ;
  lsqv:text """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?empl ?name ?email ?phone
WHERE {
  ?emplClass rdfs:subClassOf* pv:Employee .
  ?empl a ?emplClass ;
      pv:name ?name ;
      pv:email ?email .
  OPTIONAL { ?empl pv:phone ?phone }
  FILTER NOT EXISTS { [] pv:hasManager ?empl . }
}
ORDER BY ?name""" ;
  lsqv:hasStructuralFeatures _:sf27 ;
  lsqv:resultCount "141"^^xsd:integer ;
  dct:subject pv:Employee, pv:email, pv:hasManager, pv:name,
  pv:phone .

_:sf27 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Select, lsqv:TriplePattern ;
  lsqv:projectVarCount "4"^^xsd:integer ;
  lsqv:tpCount "5"^^xsd:integer ;
  lsqv:bgpCount "2"^^xsd:integer ;
  dct:subject pv:Employee, pv:email, pv:hasManager, pv:name, pv:phone .

:28 a lsqv:Query ;
  rdfs:label "Do we have any service that does apply to a BOM where parts are sourced from Russia?" ;
  dct:created "2026-03-30T16:02:31.732781Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.732781Z"^^xsd:dateTime ;
  lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

ASK
WHERE {
  { # all Russia-sourced hardware in any BOM
    SELECT ?bom ?hw
    WHERE {
      ?bom pv:hasBomPart ?bomPart .
      ?bomPart pv:hasPart ?hw .
      ?hw pv:hasSupplier ?suppl .
      ?suppl pv:addressCountry ?country .
      FILTER (CONTAINS(LCASE(?country), LCASE("Russia")))
    }
  }

  # is there a service eligible for that specific Russia-sourced hardware?
  ?s a pv:Service .
  ?s pv:eligibleFor ?hw .
}""" ;
  lsqv:hasStructuralFeatures _:sf28 ;
  lsqv:resultCount "1"^^xsd:integer ;
  dct:subject pv:Service, pv:addressCountry, pv:eligibleFor, pv:hasBomPart, pv:hasPart,
  pv:hasSupplier .

_:sf28 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Ask, lsqv:TriplePattern ;
  lsqv:projectVarCount "0"^^xsd:integer ;
  lsqv:tpCount "6"^^xsd:integer ;
  lsqv:bgpCount "1"^^xsd:integer ;
  dct:subject pv:Service, pv:addressCountry, pv:eligibleFor, pv:hasBomPart, pv:hasPart, pv:hasSupplier .

:29 a lsqv:Query ;
  rdfs:label "What suppliers - I need name, country and price - deliver the 6th to 10th most expensive hardware items." ;
  dct:created "2026-03-30T16:02:31.732846Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.732846Z"^^xsd:dateTime ;
  lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name ?country ?price
WHERE {
  ?sup a pv:Supplier ;
    pv:addressCountry ?country ;
  pv:name ?name .
  ?hw a pv:Hardware ;
  pv:price/pv:amount ?price ;
    pv:price/pv:currency "EUR" ;
    pv:hasSupplier ?sup .
}
ORDER BY DESC(?price)
LIMIT 5 OFFSET 5""" ;
  lsqv:hasStructuralFeatures _:sf29 ;
  lsqv:resultCount "5"^^xsd:integer ;
  dct:subject pv:Hardware, pv:Supplier, pv:addressCountry, pv:amount, pv:currency, pv:hasSupplier, pv:name,
  pv:price .

_:sf29 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Select, lsqv:TriplePattern ;
  lsqv:projectVarCount "3"^^xsd:integer ;
  lsqv:tpCount "7"^^xsd:integer ;
  lsqv:bgpCount "1"^^xsd:integer ;
  dct:subject pv:Hardware, pv:Supplier, pv:addressCountry, pv:amount, pv:currency, pv:hasSupplier, pv:name, pv:price .

:30 a lsqv:Query ;
  rdfs:label "Which department have more than 5 employees? I need their names and the number of employees." ;
  dct:created "2026-03-30T16:02:31.732901Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.732901Z"^^xsd:dateTime ;
  lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (COUNT(?emp) AS ?numEmployees)
WHERE {
  ?dept a pv:Department ;
    pv:name ?name .
  ?emp a pv:Employee ;
    pv:memberOf ?dept .
}
GROUP BY ?dept ?name
HAVING (COUNT(?emp) > 5)""" ;
  lsqv:hasStructuralFeatures _:sf30 ;
  lsqv:resultCount "4"^^xsd:integer ;
  dct:subject pv:Department, pv:Employee, pv:memberOf,
  pv:name .

