:25 a lsqv:Query ;
  rdfs:label "Which coil has the highest density?" ;
  dct:created "2026-03-30T16:02:31.732600Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.732600Z"^^xsd:dateTime ;
  lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE {
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Coil> .
  ?result pv:width_mm ?width_mm .
  ?result pv:depth_mm ?depth_mm .
  ?result pv:height_mm ?height_mm .
  ?result pv:weight_g ?weight_g .
  BIND(?width_mm * ?depth_mm * ?height_mm / 1000000000 AS ?volume_m3)
  BIND(?weight_g / 1000 AS ?weight_kg)
  BIND(?weight_kg / ?volume_m3 AS ?density)
}
ORDER BY DESC(?density)
LIMIT 1""" ;
  lsqv:hasStructuralFeatures _:sf25 ;
  lsqv:resultCount "0"^^xsd:integer ;
  dct:subject pv:depth_mm, pv:hasCategory, pv:height_mm, pv:weight_g, pv:width_mm,
  <http://ld.company.org/prod-instances/prod-cat-Coil> .

_:sf25 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Select, lsqv:Distinct, lsqv:TriplePattern ;
  lsqv:projectVarCount "1"^^xsd:integer ;
  lsqv:tpCount "5"^^xsd:integer ;
  lsqv:bgpCount "1"^^xsd:integer ;
  dct:subject pv:depth_mm, pv:hasCategory, pv:height_mm, pv:weight_g, pv:width_mm, <http://ld.company.org/prod-instances/prod-cat-Coil> .

