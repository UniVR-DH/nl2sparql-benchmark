:4 a lsqv:Query ;
  rdfs:label "What is the email of Sabrina from Marketing?" ;
  dct:created "2026-03-30T16:02:31.731899Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.731899Z"^^xsd:dateTime ;
  lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE {
  ?department pv:name "Marketing" .
  ?person pv:memberOf ?department .
  ?person pv:email ?result .
  ?person pv:name ?name .
  FILTER (CONTAINS(?name, "Sabrina"))
}""" ;
  lsqv:hasStructuralFeatures _:sf4 ;
  lsqv:resultCount "1"^^xsd:integer ;
  dct:subject pv:email, pv:memberOf,
  pv:name .

