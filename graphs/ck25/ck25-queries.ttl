:24 a lsqv:Query,
        qat:Comparative ;
    rdfs:label "What is the pontiometer with the smallest volume?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 8 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:Distinct,
                lsqv:Filter,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?result
WHERE {
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Potentiometer> .
  ?result pv:width_mm ?width_mm .
  ?result pv:depth_mm ?depth_mm .
  ?result pv:height_mm ?height_mm .

  BIND(?width_mm * ?depth_mm * ?height_mm AS ?volume)

  {
    SELECT (MIN(?v) AS ?minVolume)
    WHERE {
      ?r pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Potentiometer> .
      ?r pv:width_mm ?w .
      ?r pv:depth_mm ?d .
      ?r pv:height_mm ?h .
      BIND(?w * ?d * ?h AS ?v)
    }
  }

  FILTER (?volume = ?minVolume)
}""" ;
    dct:created "2026-03-30T16:02:31.732556+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.732556+00:00"^^xsd:dateTime ;
    dct:subject <http://ld.company.org/prod-instances/prod-cat-Potentiometer>,
        pv:depth_mm,
        pv:hasCategory,
        pv:height_mm,
        pv:width_mm .

:25 a lsqv:Query,
        qat:Comparative ;
    rdfs:label "Which coil has the highest density?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 10 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:Distinct,
                lsqv:Filter,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 0 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?result
WHERE {
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Coil> .
  ?result pv:width_mm ?width_mm .
  ?result pv:depth_mm ?depth_mm .
  ?result pv:height_mm ?height_mm .
  ?result pv:weight_g ?weight_g .

  BIND(?width_mm * ?depth_mm * ?height_mm / 1000000000 AS ?volume_m3)
  BIND(?weight_g / 1000 AS ?weight_kg)
  BIND(?weight_kg / ?volume_m3 AS ?density)

  {
    SELECT (MAX(?d) AS ?maxDensity)
    WHERE {
      ?r pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Coil> .
      ?r pv:width_mm ?w .
      ?r pv:depth_mm ?dp .
      ?r pv:height_mm ?h .
      ?r pv:weight_g ?wg .

      BIND(?w * ?dp * ?h / 1000000000 AS ?v_m3)
      BIND(?wg / 1000 AS ?kg)
      BIND(?kg / ?v_m3 AS ?d)
    }
  }

  FILTER (?density = ?maxDensity)
}""" ;
    dct:created "2026-03-30T16:02:31.732600+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.732600+00:00"^^xsd:dateTime ;
    dct:subject <http://ld.company.org/prod-instances/prod-cat-Coil>,
        pv:depth_mm,
        pv:hasCategory,
        pv:height_mm,
        pv:weight_g,
        pv:width_mm .

