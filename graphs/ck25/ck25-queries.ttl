:32 a lsqv:Query ;
  rdfs:label "For each supplier, what's the average price (in EUR) of what they sell, round reasonably?" ;
  dct:created "2026-03-30T16:02:31.732987Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.732987Z"^^xsd:dateTime ;
  lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (ROUND(AVG(?amt) * 100) / 100 AS ?avgEur) WHERE {
  ?sup a pv:Supplier ;
    pv:name ?name .
  ?hw pv:hasSupplier ?sup ;
    pv:price/pv:amount ?amt ;
    pv:price/pv:currency "EUR" .
}
GROUP BY ?sup ?name""" ;
  lsqv:hasStructuralFeatures _:sf32 ;
  lsqv:resultCount "246"^^xsd:integer ;
  dct:subject pv:Supplier, pv:amount, pv:currency, pv:hasSupplier, pv:name,
  pv:price .

