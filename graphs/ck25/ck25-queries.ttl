:1 a lsqv:Query,
        qat:Enumeration ;
    rdfs:label "In which department is Ms. Brant?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE {
  <http://ld.company.org/prod-instances/empl-Karen.Brant%40company.org> pv:memberOf ?result .
  ?result a pv:Department .
}""" ;
    dct:created "2026-03-30T16:02:31.731362+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.731362+00:00"^^xsd:dateTime ;
    dct:subject <http://ld.company.org/prod-instances/empl-Karen.Brant%40company.org>,
        pv:Department,
        pv:memberOf .

