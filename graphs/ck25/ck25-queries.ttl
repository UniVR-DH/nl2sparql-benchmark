:42 a lsqv:Query,
        qat:AggregateEnumeration,
        qat:Comparative ;
    rdfs:label "Which Bill-of-Material has the highest average unit cost of its hardware parts, and what is that average?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 10 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:Filter,
                lsqv:GroupBy,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?bom ?avgUnitCost
WHERE {
  {
    SELECT ?bom (ROUND(AVG(?spst / ?sq) * 100) / 100 AS ?avgUnitCost)
    WHERE {
      {
        SELECT ?bom (SUM(?partSubTotal) AS ?spst) (SUM(xsd:int(?quant)) AS ?sq)
        WHERE {
          ?bom a pv:BillOfMaterial ;
               pv:hasBomPart ?part .
          ?part pv:quantity ?quant .
          ?part pv:hasPart/pv:price/pv:amount ?amount .
          ?part pv:hasPart/pv:price/pv:currency "EUR" .
          BIND(xsd:int(?quant) * ?amount AS ?partSubTotal)
        }
        GROUP BY ?bom
      }
    }
    GROUP BY ?bom
  }

  {
    SELECT (MAX(?avg) AS ?maxAvg)
    WHERE {
      {
        SELECT ?bom (ROUND(AVG(?spst / ?sq) * 100) / 100 AS ?avg)
        WHERE {
          {
            SELECT ?bom (SUM(?partSubTotal) AS ?spst) (SUM(xsd:int(?quant)) AS ?sq)
            WHERE {
              ?bom a pv:BillOfMaterial ;
                   pv:hasBomPart ?part .
              ?part pv:quantity ?quant .
              ?part pv:hasPart/pv:price/pv:amount ?amount .
              ?part pv:hasPart/pv:price/pv:currency "EUR" .
              BIND(xsd:int(?quant) * ?amount AS ?partSubTotal)
            }
            GROUP BY ?bom
          }
        }
        GROUP BY ?bom
      }
    }
  }

  FILTER (?avgUnitCost = ?maxAvg)
}""" ;
    dct:created "2026-03-30T16:02:31.733417+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733417+00:00"^^xsd:dateTime ;
    dct:subject pv:BillOfMaterial,
        pv:amount,
        pv:currency,
        pv:hasBomPart,
        pv:hasPart,
        pv:price,
        pv:quantity .

:44 a lsqv:Query,
        qat:Aggregation,
        qat:RankedListing ;
    rdfs:label "Which hardware items have dimensions in the top 10 % of all widths, and what are their IDs, names and widths?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 3 ;
            lsqv:tpCount 6 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:Filter,
                lsqv:OrderBy,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern,
                lsqv:fn-gt ] ;
    lsqv:resultCount 93 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?id ?name ?width
WHERE {
  { # get min-max range
    SELECT (MIN(?width) AS ?minW) (MAX(?width) AS ?maxW)
    WHERE {
      ?hw a pv:Hardware ;
        pv:width_mm ?width .
    }
  }

  # get 90. percentile
  BIND(?minW + (0.9 * (?maxW - ?minW)) AS ?pct90)

  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name ;
    pv:width_mm ?width .

  FILTER(?width >= ?pct90)
}
ORDER BY DESC(?width)""" ;
    dct:created "2026-03-30T16:02:31.733514+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733514+00:00"^^xsd:dateTime ;
    dct:subject pv:Hardware,
        pv:id,
        pv:name,
        pv:width_mm .

:45 a lsqv:Query,
        qat:Comparative ;
    rdfs:label "Which supplier delivers the most reliable Inductor?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 5 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Distinct,
                lsqv:Filter,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?result
WHERE {
  ?hardware pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Inductor> .
  ?hardware pv:reliabilityIndex ?reliabilityIndex .
  ?hardware pv:hasSupplier ?result .

  {
    SELECT (MAX(?ri) AS ?maxRI)
    WHERE {
      ?h pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Inductor> .
      ?h pv:reliabilityIndex ?ri .
    }
  }

  FILTER(?reliabilityIndex = ?maxRI)
}""" ;
    dct:created "2026-03-30T16:02:31.733565+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733565+00:00"^^xsd:dateTime ;
    dct:subject <http://ld.company.org/prod-instances/prod-cat-Inductor>,
        pv:hasCategory,
        pv:hasSupplier,
        pv:reliabilityIndex .

:46 a lsqv:Query,
        qat:AggregateEnumeration,
        qat:Comparative,
        qat:LimitedRankedListing ;
    rdfs:label "What are the top 5 suppliers with best average reliability over their products." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 4 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Distinct,
                lsqv:Filter,
                lsqv:GroupBy,
                lsqv:Limit,
                lsqv:OrderBy,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 5 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?supplier ?avgReliability
WHERE {
  {
    SELECT ?supplier (AVG(?ri) AS ?avgReliability)
    WHERE {
      ?hardware pv:hasSupplier ?supplier ;
                pv:reliabilityIndex ?ri .
    }
    GROUP BY ?supplier
  }

  {
    SELECT (MIN(?topVal) AS ?threshold)
    WHERE {
      SELECT (AVG(?ri) AS ?topVal)
      WHERE {
        ?h pv:hasSupplier ?s ;
           pv:reliabilityIndex ?ri .
      }
      GROUP BY ?s
      ORDER BY DESC(?topVal)
      LIMIT 5
    }
  }

  FILTER(?avgReliability >= ?threshold)
}
ORDER BY DESC(?avgReliability) ?supplier""" ;
    dct:created "2026-03-30T16:02:31.733601+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733601+00:00"^^xsd:dateTime ;
    dct:subject pv:hasSupplier,
        pv:reliabilityIndex .

