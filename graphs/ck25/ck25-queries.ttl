:16 a lsqv:Query,
        qat:Confirmation ;
    rdfs:label "Do we have suppliers in Toulouse?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 0 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Ask,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
ASK
WHERE {
  ?result a pv:Supplier .
  ?supplier pv:addressLocality "Toulouse" .
}""" ;
    dct:created "2026-03-30T16:02:31.732295+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.732295+00:00"^^xsd:dateTime ;
    dct:subject pv:addressLocality,
        pv:hasSupplier .

:17 a lsqv:Query,
        qat:Enumeration ;
    rdfs:label "Which suppliers do we have in Toulouse?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE {
  ?result a pv:Supplier .
  ?result pv:addressLocality "Toulouse" .
}""" ;
    dct:created "2026-03-30T16:02:31.732321+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.732321+00:00"^^xsd:dateTime ;
    dct:subject pv:addressLocality,
        pv:hasSupplier .

:3 a lsqv:Query,
        qat:Enumeration ;
    rdfs:label "Who is the manager of Heinrich Hoch?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 1 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE {
  <http://ld.company.org/prod-instances/empl-Heinrich.Hoch%40company.org> pv:hasManager ?result .
}""" ;
    dct:created "2026-03-30T16:02:31.731867+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.731867+00:00"^^xsd:dateTime ;
    dct:subject <http://ld.company.org/prod-instances/empl-Heinrich.Hoch%40company.org>,
        pv:hasManager .

:41 a lsqv:Query,
        qat:AggregateEnumeration ;
    rdfs:label "For each manager, what percentage of their entire team work in the same department as the manager?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 3 ;
            lsqv:projectVarCount 3 ;
            lsqv:tpCount 5 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:GroupBy,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern,
                lsqv:agg-count ] ;
    lsqv:resultCount 6 ;
    lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?m ?name (?deptTeam / ?fullteam * 100 AS ?pct)
WHERE {

  ?m pv:name ?name .

  { # full team
    SELECT ?m (COUNT(*) AS ?fullteam) WHERE {
      ?e pv:hasManager ?m .
    } GROUP BY ?m
  }

  { # team in same dept
    SELECT ?m (COUNT(*) AS ?deptTeam) WHERE {
      ?m pv:memberOf ?dept .
      ?e pv:hasManager ?m .
      ?e pv:memberOf ?dept .
    } GROUP BY ?m
  }
}""" ;
    dct:created "2026-03-30T16:02:31.733366+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733366+00:00"^^xsd:dateTime ;
    dct:subject pv:hasManager,
        pv:memberOf,
        pv:name .

:43 a lsqv:Query,
        qat:Factoid ;
    rdfs:label "Show me any cycles of product compatibility — i.e. product A says it's compatible with B, and B says it's compatible with A (mutual pairs)." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Filter,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 969 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?a ?b
WHERE {
  ?a pv:compatibleProduct ?b .
  ?b pv:compatibleProduct ?a .
  FILTER (STR(?a) < STR(?b))
}""" ;
    dct:created "2026-03-30T16:02:31.733487+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733487+00:00"^^xsd:dateTime ;
    dct:subject pv:compatibleProduct .

