:46 a lsqv:Query ;
  rdfs:label "What are the top 5 suppliers with best average reliability over their products." ;
  dct:created "2026-03-30T16:02:31.733601Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733601Z"^^xsd:dateTime ;
  lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result (AVG(?reliabilityIndex) AS ?averageReliabilityIndex)
WHERE {
  ?hardware pv:reliabilityIndex ?reliabilityIndex .
  ?hardware pv:hasSupplier ?result .
}
GROUP BY ?result
ORDER BY DESC(?averageReliabilityIndex)
LIMIT 5""" ;
  lsqv:hasStructuralFeatures _:sf46 ;
  lsqv:resultCount "5"^^xsd:integer ;
  dct:subject pv:hasSupplier, pv:reliabilityIndex .

_:sf46 a lsqv:StructuralFeatures ;
