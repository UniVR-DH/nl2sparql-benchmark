:15 a lsqv:Query,
        qat:Comparative ;
    rdfs:label "What is the cheapest Encoder we can get from a french or german supplier?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 10 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Distinct,
                lsqv:Filter,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?result 
WHERE {
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Encoder> .
  ?result pv:price ?priceR .
  ?priceR pv:amount ?price .
  ?result pv:hasSupplier ?supplier .
  ?supplier pv:addressCountry ?country .
  FILTER ( (?country = "France") || (?country = "Germany") )

  {
    SELECT (MIN(?p) AS ?minPrice)
    WHERE {
      ?r pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Encoder> .
      ?r pv:price ?pr .
      ?pr pv:amount ?p .
      ?r pv:hasSupplier ?s .
      ?s pv:addressCountry ?c .
      FILTER ( (?c = "France") || (?c = "Germany") )
    }
  }

  FILTER (?price = ?minPrice)
}""" ;
