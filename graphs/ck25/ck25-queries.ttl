:21 a lsqv:Query,
        qat:Comparative ;
    rdfs:label "What is the heaviest coil that does not exceed a base area of 15x15 milimeter?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 8 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Distinct,
                lsqv:Filter,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?result 
WHERE {
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Coil> .
  ?result pv:weight_g ?weight_g .
  ?result pv:width_mm ?width_mm .
  ?result pv:depth_mm ?depth_mm .

  FILTER (?width_mm <= 15)
  FILTER (?depth_mm <= 15)

  {
    SELECT (MAX(?w) AS ?maxWeight)
    WHERE {
      ?r pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Coil> .
      ?r pv:weight_g ?w .
      ?r pv:width_mm ?wmm .
      ?r pv:depth_mm ?dmm .
      FILTER (?wmm <= 15)
      FILTER (?dmm <= 15)
    }
  }

  FILTER (?weight_g = ?maxWeight)
}""" ;
