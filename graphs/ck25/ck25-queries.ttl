  dct:subject pv:Department, pv:Employee, pv:memberOf, pv:name .

:31 a lsqv:Query ;
  rdfs:label "Per product category, what's our lightest and heaviest hardware item?" ;
  dct:created "2026-03-30T16:02:31.732941Z"^^xsd:dateTime ;
