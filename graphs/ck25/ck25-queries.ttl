:40 a lsqv:Query,
        qat:CounterFactualIdentification ;
    rdfs:label "Which hardware items - list id and name - have no active product manager?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 3 ;
            lsqv:tpCount 4 ;
            lsqv:usesFeature lsqv:NotExists,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 48 ;
    lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?hw ?id ?name
WHERE {
  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name .
  FILTER NOT EXISTS { ?hw pv:hasProductManager/pv:name [] . }
