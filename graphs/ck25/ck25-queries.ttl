:15 a lsqv:Query ;
  rdfs:label "What is the cheapest Encoder we can get from a french or german supplier?" ;
  dct:created "2026-03-30T16:02:31.732247Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.732247Z"^^xsd:dateTime ;
  lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE {
  ?result pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Encoder> .
  ?result pv:price ?priceR .
  ?priceR pv:amount ?price .
  ?result pv:hasSupplier ?supplier .
  ?supplier pv:addressCountry ?country .
  FILTER ( (?country = "France") ||  (?country = "Germany") )
}
ORDER BY ASC(?price)
LIMIT 1""" ;
  lsqv:hasStructuralFeatures _:sf15 ;
  lsqv:resultCount "1"^^xsd:integer ;
  dct:subject pv:addressCountry, pv:amount, pv:hasCategory, pv:hasSupplier, pv:price,
  <http://ld.company.org/prod-instances/prod-cat-Encoder> .

_:sf15 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Select, lsqv:Distinct, lsqv:TriplePattern ;
  lsqv:projectVarCount "1"^^xsd:integer ;
  lsqv:tpCount "5"^^xsd:integer ;
  lsqv:bgpCount "1"^^xsd:integer ;
  dct:subject pv:addressCountry, pv:amount, pv:hasCategory, pv:hasSupplier, pv:price, <http://ld.company.org/prod-instances/prod-cat-Encoder> .

