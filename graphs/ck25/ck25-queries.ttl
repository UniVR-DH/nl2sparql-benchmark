:27 a lsqv:Query,
        qat:CounterFactualIdentification,
        qat:RankedListing ;
    rdfs:label "Give me a phone directory of everyone on staff who does not manage anyone, I need name, email, and phone, sorted by name?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 3 ;
            lsqv:projectVarCount 4 ;
            lsqv:tpCount 6 ;
            lsqv:usesFeature lsqv:NotExists,
                lsqv:Optional,
                lsqv:OrderBy,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 141 ;
    lsqv:text """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?empl ?name ?email ?phone
WHERE {
  ?emplClass rdfs:subClassOf* pv:Employee .
  ?empl a ?emplClass ;
      pv:name ?name ;
      pv:email ?email .
  OPTIONAL { ?empl pv:phone ?phone }
  FILTER NOT EXISTS { [] pv:hasManager ?empl . }
}
ORDER BY ?name""" ;
    dct:created "2026-03-30T16:02:31.732700+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.732700+00:00"^^xsd:dateTime ;
    dct:subject pv:Employee,
        pv:email,
        pv:hasManager,
        pv:name,
        pv:phone .

:28 a lsqv:Query,
        qat:Confirmation ;
    rdfs:label "Do we have any service that does apply to a BOM where parts are sourced from Russia?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 0 ;
            lsqv:tpCount 6 ;
            lsqv:usesFeature lsqv:Ask,
                lsqv:Filter,
                lsqv:SubQuery,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

ASK
WHERE {
  { # all Russia-sourced hardware in any BOM
    SELECT ?bom ?hw
    WHERE {
      ?bom pv:hasBomPart ?bomPart .
      ?bomPart pv:hasPart ?hw .
      ?hw pv:hasSupplier ?suppl .
      ?suppl pv:addressCountry ?country .
      FILTER (CONTAINS(LCASE(?country), LCASE("Russia")))
    }
  }

  # is there a service eligible for that specific Russia-sourced hardware?
  ?s a pv:Service .
  ?s pv:eligibleFor ?hw .
}""" ;
    dct:created "2026-03-30T16:02:31.732781+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.732781+00:00"^^xsd:dateTime ;
    dct:subject pv:Service,
        pv:addressCountry,
        pv:eligibleFor,
        pv:hasBomPart,
        pv:hasPart,
        pv:hasSupplier .

:29 a lsqv:Query,
        qat:LimitedRankedListing ;
    rdfs:label "What suppliers - I need name, country and price - deliver the 6th to 10th most expensive hardware items." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 3 ;
            lsqv:tpCount 7 ;
            lsqv:usesFeature lsqv:Limit,
                lsqv:Offset,
                lsqv:OrderBy,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 5 ;
    lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name ?country ?price
WHERE {
  ?sup a pv:Supplier ;
    pv:addressCountry ?country ;
  pv:name ?name .
  ?hw a pv:Hardware ;
  pv:price/pv:amount ?price ;
    pv:price/pv:currency "EUR" ;
    pv:hasSupplier ?sup .
}
ORDER BY DESC(?price)
LIMIT 5 OFFSET 10""" ;
    dct:created "2026-03-30T16:02:31.732846+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.732846+00:00"^^xsd:dateTime ;
    dct:subject pv:Hardware,
        pv:Supplier,
        pv:addressCountry,
        pv:amount,
        pv:currency,
        pv:hasSupplier,
        pv:name,
        pv:price .

:30 a lsqv:Query,
        qat:AggregateEnumeration ;
    rdfs:label "Which department have more than 5 employees? I need their names and the number of employees." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 4 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:GroupBy,
                lsqv:Having,
                lsqv:Select,
                lsqv:TriplePattern,
                lsqv:agg-count,
                lsqv:fn-gt ] ;
    lsqv:resultCount 4 ;
    lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name (COUNT(?emp) AS ?numEmployees)
WHERE {
  ?dept a pv:Department ;
    pv:name ?name .
  ?emp a pv:Employee ;
    pv:memberOf ?dept .
}
GROUP BY ?dept ?name
HAVING (COUNT(?emp) > 5)""" ;
    dct:created "2026-03-30T16:02:31.732901+00:00"^^xsd:dateTime ;
