:50 a lsqv:Query,
        qat:AggregateEnumeration,
        qat:Comparative ;
    rdfs:label "Which department is resposible for the most product and how many product are this?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Filter,
                lsqv:GroupBy,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern,
                lsqv:agg-count ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?result ?count
WHERE {
  {
    SELECT ?result (COUNT(?product) AS ?count)
    WHERE {
      ?result pv:responsibleFor ?product .
    }
    GROUP BY ?result
  }
  {
    SELECT (MAX(?c_inner) AS ?maxCount)
    WHERE {
      SELECT ?r_inner (COUNT(?p_inner) AS ?c_inner)
      WHERE {
        ?r_inner pv:responsibleFor ?p_inner .
      }
      GROUP BY ?r_inner
    }
  }
  FILTER (?count = ?maxCount)
}""" ;
    dct:created "2026-03-30T16:02:31.733737+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733737+00:00"^^xsd:dateTime ;
    dct:subject pv:responsibleFor .

