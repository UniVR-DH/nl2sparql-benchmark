:41 a lsqv:Query ;
  rdfs:label "For each manager, what percentage of their entire team work in the same department as the manager?" ;
  dct:created "2026-03-30T16:02:31.733366Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733366Z"^^xsd:dateTime ;
  lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?m ?name (?deptTeam / ?fullteam * 100 AS ?pct)
WHERE {

  ?m pv:name ?name .

  { # full team
    SELECT ?m (COUNT(*) AS ?fullteam) WHERE {
      ?e pv:hasManager ?m .
    } GROUP BY ?m
  }

  { # team in same dept
    SELECT ?m (COUNT(*) AS ?deptTeam) WHERE {
      ?m pv:memberOf ?dept .
      ?e pv:hasManager ?m .
      ?e pv:memberOf ?dept .
    } GROUP BY ?m
  }
}""" ;
  lsqv:hasStructuralFeatures _:sf41 ;
  lsqv:resultCount "6"^^xsd:integer ;
  dct:subject pv:hasManager, pv:memberOf,
  pv:name .

_:sf41 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Select, lsqv:GroupBy, lsqv:Aggregators, lsqv:agg-count, lsqv:TriplePattern ;
  lsqv:projectVarCount "2"^^xsd:integer ;
  lsqv:tpCount "5"^^xsd:integer ;
  lsqv:bgpCount "1"^^xsd:integer ;
  dct:subject pv:hasManager, pv:memberOf, pv:name .

:42 a lsqv:Query ;
  rdfs:label "Which Bill-of-Material has the highest average unit cost of its hardware parts, and what is that average?" ;
  dct:created "2026-03-30T16:02:31.733417Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733417Z"^^xsd:dateTime ;
  lsqv:text """PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?bom (ROUND(AVG(?spst / ?sq) * 100) / 100 AS ?avgUnitCost)
WHERE {
  {
    SELECT ?bom (SUM(?partSubTotal) AS ?spst) (SUM(xsd:int(?quant)) AS ?sq)
    WHERE {
      ?bom a pv:BillOfMaterial ;
        pv:hasBomPart ?part .
      ?part pv:quantity ?quant .
      ?part pv:hasPart/pv:price/pv:amount ?amount .
      ?part pv:hasPart/pv:price/pv:currency "EUR" .
      BIND(xsd:int(?quant) * ?amount AS ?partSubTotal)
    }
    GROUP BY ?bom
  }
}
GROUP BY ?bom
ORDER BY DESC(?avgUnitCost)
LIMIT 1""" ;
  lsqv:hasStructuralFeatures _:sf42 ;
  lsqv:resultCount "1"^^xsd:integer ;
  dct:subject pv:BillOfMaterial, pv:amount, pv:currency, pv:hasBomPart, pv:hasPart, pv:price,
  pv:quantity .

_:sf42 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Select, lsqv:GroupBy, lsqv:TriplePattern ;
  lsqv:projectVarCount "2"^^xsd:integer ;
  lsqv:tpCount "5"^^xsd:integer ;
  lsqv:bgpCount "1"^^xsd:integer ;
  dct:subject pv:BillOfMaterial, pv:amount, pv:currency, pv:hasBomPart, pv:hasPart, pv:price, pv:quantity .

:43 a lsqv:Query ;
  rdfs:label "Show me any cycles of product compatibility — i.e. product A says it's compatible with B, and B says it's compatible with A (mutual pairs)." ;
  dct:created "2026-03-30T16:02:31.733487Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733487Z"^^xsd:dateTime ;
  lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?a ?b
WHERE {
  ?a pv:compatibleProduct ?b .
  ?b pv:compatibleProduct ?a .
  FILTER (STR(?a) < STR(?b))
}""" ;
  lsqv:hasStructuralFeatures _:sf43 ;
  lsqv:resultCount "969"^^xsd:integer ;
  dct:subject pv:compatibleProduct .

_:sf43 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Select, lsqv:TriplePattern ;
  lsqv:projectVarCount "2"^^xsd:integer ;
  lsqv:tpCount "2"^^xsd:integer ;
  lsqv:bgpCount "1"^^xsd:integer ;
  dct:subject pv:compatibleProduct .

:44 a lsqv:Query ;
  rdfs:label "Which hardware items have dimensions in the top 10 % of all widths, and what are their IDs, names and widths?" ;
  dct:created "2026-03-30T16:02:31.733514Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733514Z"^^xsd:dateTime ;
  lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?id ?name ?width
WHERE {
  { # get min-max range
    SELECT (MIN(?width) AS ?minW) (MAX(?width) AS ?maxW)
    WHERE {
      ?hw a pv:Hardware ;
        pv:width_mm ?width .
    }
  }

  # get 90. percentile
  BIND(?minW + (0.9 * (?maxW - ?minW)) AS ?pct90)

  ?hw a pv:Hardware ;
    pv:id ?id ;
    pv:name ?name ;
    pv:width_mm ?width .

  FILTER(?width >= ?pct90)
}
ORDER BY DESC(?width)""" ;
  lsqv:hasStructuralFeatures _:sf44 ;
  lsqv:resultCount "93"^^xsd:integer ;
  dct:subject pv:Hardware, pv:id, pv:name,
  pv:width_mm .

_:sf44 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Select, lsqv:fn-gt, lsqv:TriplePattern ;
  lsqv:projectVarCount "3"^^xsd:integer ;
  lsqv:tpCount "6"^^xsd:integer ;
  lsqv:bgpCount "1"^^xsd:integer ;
  dct:subject pv:Hardware, pv:id, pv:name, pv:width_mm .

:45 a lsqv:Query ;
  rdfs:label "Which supplier delivers the most reliable Inductor?" ;
  dct:created "2026-03-30T16:02:31.733565Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733565Z"^^xsd:dateTime ;
  lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE {
  ?hardware pv:hasCategory <http://ld.company.org/prod-instances/prod-cat-Inductor> .
  ?hardware pv:reliabilityIndex ?reliabilityIndex .
  ?hardware pv:hasSupplier ?result .
}
ORDER BY DESC(?reliabilityIndex)
LIMIT 1""" ;
