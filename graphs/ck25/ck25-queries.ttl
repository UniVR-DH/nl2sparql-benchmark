    lsqv:resultCount 1 ;
    lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

ASK
WHERE {
  ?dept a pv:Department .
  FILTER NOT EXISTS {
    ?m pv:memberOf ?dept .
    ?m a pv:Manager .
  }
}""" ;
