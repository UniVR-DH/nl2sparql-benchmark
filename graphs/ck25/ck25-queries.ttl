    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT DISTINCT ?result 
WHERE {
  ?result a pv:Service .
  ?result pv:price ?priceR .
  ?priceR pv:amount ?price .

  {
    SELECT (MAX(?p) AS ?maxPrice)
    WHERE {
      ?r a pv:Service .
      ?r pv:price ?pr .
      ?pr pv:amount ?p .
    }
  }

  FILTER (?price = ?maxPrice)
}""" ;
