:33 a lsqv:Query,
        qat:Confirmation ;
    rdfs:label "Are there departments with no manager assigned?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 0 ;
            lsqv:tpCount 3 ;
            lsqv:usesFeature lsqv:Ask,
                lsqv:NotExists,
