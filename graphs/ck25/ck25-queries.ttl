:34 a lsqv:Query,
        qat:Factoid ;
    rdfs:label "I need to update my supplier rolodex, give me every supplier's name and all address details." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 4 ;
            lsqv:projectVarCount 4 ;
            lsqv:tpCount 5 ;
            lsqv:usesFeature lsqv:Optional,
