:35 a lsqv:Query,
        qat:Factoid ;
    rdfs:label "For every product, list what other products it is compatible with and the price differences between both." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 3 ;
            lsqv:tpCount 7 ;
            lsqv:usesFeature lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 5814 ;
    lsqv:text """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv:    <http://ld.company.org/prod-vocab/>

SELECT ?prod ?compatible (?prodAmount - ?compatibleAmount AS ?priceDiff)
WHERE {
  ?prodClass rdfs:subClassOf* pv:Product .
  ?prod a ?prodClass ;
    pv:compatibleProduct ?compatible .
  ?prod pv:price/pv:amount ?prodAmount ;
    pv:price/pv:currency "EUR" .
  ?compatible pv:price/pv:amount ?compatibleAmount ;
    pv:price/pv:currency "EUR" .
}""" ;
    dct:created "2026-03-30T16:02:31.733107+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733107+00:00"^^xsd:dateTime ;
    dct:subject pv:Product,
        pv:amount,
        pv:compatibleProduct,
        pv:currency,
        pv:price .

:36 a lsqv:Query,
        qat:AggregateEnumeration,
        qat:Comparative ;
    rdfs:label "Which area of expertise is most relevant among our products, what are the top three skills?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 4 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 9 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:Filter,
                lsqv:GroupBy,
                lsqv:OrderBy,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern,
                lsqv:agg-count ] ;
    lsqv:resultCount 3 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?cat ?name
WHERE {
  {
    SELECT ?cat ?name (COUNT(?hw) AS ?cnt)
    WHERE {
      ?hw a pv:Hardware ;
          pv:hasCategory ?cat .
      ?cat pv:name ?name .
    }
    GROUP BY ?cat ?name
  }
  {
    SELECT (MIN(?c_threshold) AS ?minTopThree)
    WHERE {
      {
        SELECT ?cat_inner (COUNT(?hw_inner) AS ?c_inner)
        WHERE {
          ?hw_inner a pv:Hardware ;
                    pv:hasCategory ?cat_inner .
        }
        GROUP BY ?cat_inner
      }
      {
        SELECT (COUNT(DISTINCT ?cat_rank) AS ?rank_count) 
               ?c_threshold
        WHERE {
          {
            SELECT ?cat_inner2 (COUNT(?hw_inner2) AS ?c_inner2)
            WHERE {
              ?hw_inner2 a pv:Hardware ;
                         pv:hasCategory ?cat_inner2 .
            }
            GROUP BY ?cat_inner2
          }
          {
            SELECT ?cat_rank (COUNT(?hw_rank) AS ?c_rank)
            WHERE {
              ?hw_rank a pv:Hardware ;
                       pv:hasCategory ?cat_rank .
            }
            GROUP BY ?cat_rank
          }
          FILTER (?c_rank > ?c_inner2)
          BIND(?c_inner2 AS ?c_threshold)
        }
        GROUP BY ?c_threshold
        HAVING (COUNT(DISTINCT ?cat_rank) < 3)
      }
      FILTER (?c_inner = ?c_threshold)
    }
  }
  FILTER (?cnt >= ?minTopThree)
}
ORDER BY DESC(?cnt)""" ;
    dct:created "2026-03-30T16:02:31.733164+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733164+00:00"^^xsd:dateTime ;
    dct:subject pv:Hardware,
        pv:hasCategory,
        pv:name .

:37 a lsqv:Query,
        qat:AggregateEnumeration ;
    rdfs:label "For each Bill of Material, how many parts does it contain and what is the total material quantity — show me only those BOMs exceeding 600 total items and order them descending." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 3 ;
            lsqv:tpCount 3 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:GroupBy,
                lsqv:Having,
                lsqv:OrderBy,
                lsqv:Select,
                lsqv:TriplePattern,
                lsqv:agg-count,
                lsqv:fn-gt ] ;
    lsqv:resultCount 7 ;
    lsqv:text """PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?bom (COUNT(?part) AS ?partCount) (SUM(?qty) AS ?totalQty)
WHERE {
  ?bom a pv:BillOfMaterial ;
    pv:hasBomPart ?part .
  ?part pv:quantity ?qty_ .
  BIND(xsd:int(?qty_) AS ?qty)
}
GROUP BY ?bom
HAVING (SUM(?qty) > 600)
ORDER BY DESC(SUM(?qty))""" ;
    dct:created "2026-03-30T16:02:31.733199+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733199+00:00"^^xsd:dateTime ;
    dct:subject pv:BillOfMaterial,
        pv:hasBomPart,
        pv:quantity .

:38 a lsqv:Query,
        qat:Factoid ;
    rdfs:label "I want to update my contact list, for each Employee give me name, email, phone number and the department they belong to as well as their direct report." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 5 ;
