:48 a lsqv:Query,
        qat:Enumeration ;
    rdfs:label "Show me all BOMs which have at least on part from a polish supplier." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 5 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 3 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE {
  ?result a pv:BillOfMaterial .
  ?result pv:hasBomPart ?bomPart .
  ?bomPart pv:hasPart ?product .
  ?product pv:hasSupplier ?supplier .
  ?supplier pv:country <http://dbpedia.org/resource/Poland> .
}""" ;
    dct:created "2026-03-30T16:02:31.733667+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733667+00:00"^^xsd:dateTime ;
    dct:subject <http://dbpedia.org/resource/Poland>,
        pv:BillOfMaterial,
        pv:country,
        pv:hasBomPart,
        pv:hasPart,
        pv:hasSupplier .

:49 a lsqv:Query,
        qat:Aggregation ;
    rdfs:label "How many suppliers can deliver alternative compatible products for the K367 Strain Encoder?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Select,
                lsqv:TriplePattern,
                lsqv:agg-count ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT (COUNT(DISTINCT ?supplier) AS ?result)
WHERE {
  <http://ld.company.org/prod-instances/hw-K367-1320550> pv:compatibleProduct ?alternative .
  ?alternative pv:hasSupplier ?supplier .
}""" ;
    dct:created "2026-03-30T16:02:31.733706+00:00"^^xsd:dateTime ;
    dct:modified "2026-03-30T16:02:31.733706+00:00"^^xsd:dateTime ;
    dct:subject <http://ld.company.org/prod-instances/hw-K367-1320550>,
        pv:compatibleProduct,
        pv:hasSupplier .

