:38 a lsqv:Query,
        qat:AggregateEnumeration,
        qat:Factoid,
        qat:LimitedRankedListing ;
    rdfs:label "List the 10 directors who worked on most movies." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 1 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:Count,
                lsqv:GroupBy,
                lsqv:Groupby,
                lsqv:Limit,
                lsqv:OrderBy,
                lsqv:Orderby,
                lsqv:Sample,
                lsqv:Select ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX dbo: <http://dbpedia.org/ontology/>
SELECT ?director WHERE {
  ?film dbo:director ?director .
}
GROUP BY ?director
ORDER BY DESC(COUNT(?film))
LIMIT 10
""" ;
    dct:created "2026-07-22T15:16:26+00:00"^^xsd:dateTime ;
    dct:modified "2026-07-22T15:16:26+00:00"^^xsd:dateTime .

