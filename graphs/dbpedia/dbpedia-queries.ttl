:28 a lsqv:Query,
        qat:Enumeration,
        qat:Factoid ;
    rdfs:label "List all the vineyards in France." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 3 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 4 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Select,
                lsqv:Union ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX res: <http://dbpedia.org/resource/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?uri WHERE {
  ?uri rdf:type dbo:Winery .
  { ?uri dbo:location res:France . } UNION { ?uri dbo:location ?x . ?x dbo:country res:France . }
}
""" ;
    dct:created "2026-07-22T15:16:26+00:00"^^xsd:dateTime ;
    dct:modified "2026-07-22T15:16:26+00:00"^^xsd:dateTime .

