:46 a lsqv:Query,
        qat:AggregateEnumeration,
        qat:Factoid ;
    rdfs:label "List all bands according to the amount of songs they published." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:Count,
                lsqv:GroupBy,
                lsqv:Groupby,
                lsqv:OrderBy,
                lsqv:Orderby,
                lsqv:Sample,
                lsqv:Select ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX dbo: <http://dbpedia.org/ontology/>
SELECT ?band WHERE {
  ?song dbo:musicalArtist ?band .
  ?band a dbo:Band .
}
GROUP BY ?band
ORDER BY DESC(COUNT(?song))
""" ;
    dct:created "2026-07-22T15:16:26+00:00"^^xsd:dateTime ;
    dct:modified "2026-07-22T15:16:26+00:00"^^xsd:dateTime .

