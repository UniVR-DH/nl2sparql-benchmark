                lsqv:Regex,
                lsqv:Select,
                lsqv:Union ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?uri WHERE {
  ?uri rdf:type dbo:Organisation .
  { ?uri dbo:formationYear ?date . } UNION { ?uri dbo:foundingYear ?date. }
  FILTER regex(?date, '^1990') .
}
""" ;
    dct:created "2026-07-22T15:16:26+00:00"^^xsd:dateTime ;
    dct:modified "2026-07-22T15:16:26+00:00"^^xsd:dateTime .

