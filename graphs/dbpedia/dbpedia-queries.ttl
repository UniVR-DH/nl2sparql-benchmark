:10 a lsqv:Query,
        qat:Enumeration,
        qat:Factoid ;
    rdfs:label "Which teams have players in the Wide Receiver position in American football?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 3 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Select ] ;
    lsqv:resultCount 1 ;
    lsqv:text """SELECT DISTINCT ?uri WHERE {
  ?x <http://dbpedia.org/property/position> <http://dbpedia.org/resource/Wide_receiver> .
  ?x <http://dbpedia.org/ontology/team> ?uri .
  ?x <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://dbpedia.org/ontology/AmericanFootballPlayer> .
}
""" ;
    dct:created "2026-07-22T15:16:26+00:00"^^xsd:dateTime ;
    dct:modified "2026-07-22T15:16:26+00:00"^^xsd:dateTime .

