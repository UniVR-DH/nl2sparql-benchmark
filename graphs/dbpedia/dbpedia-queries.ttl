:76 a lsqv:Query,
        qat:Enumeration,
        qat:Factoid ;
    rdfs:label "Give me all prime ministers of the United Kingdom." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 4 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 5 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Filter,
                lsqv:Lang,
                lsqv:Regex,
                lsqv:Select,
                lsqv:Union ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX yago: <http://dbpedia.org/class/yago/>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbp: <http://dbpedia.org/property/>
PREFIX res: <http://dbpedia.org/resource/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?uri ?string 
WHERE {
        ?uri rdf:type dbo:Person .
        { ?uri rdf:type yago:PrimeMinistersOfTheUnitedKingdom. }
        UNION
        { ?uri rdf:type dbo:PrimeMinister.
          ?uri dbp:title res:Prime_Minister_of_the_United_Kingdom. }
        ?uri rdfs:label ?string. 
        FILTER (lang(?string) = 'en' && !regex(?string,'Prime Ministership','i') && !regex(?string,'and the')) .
}
""" ;
    dct:created "2026-07-22T15:16:26+00:00"^^xsd:dateTime ;
    dct:modified "2026-07-22T15:16:26+00:00"^^xsd:dateTime .

:77 a lsqv:Query,
