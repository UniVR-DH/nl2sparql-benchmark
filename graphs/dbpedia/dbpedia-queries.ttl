:11 a lsqv:Query,
        qat:Factoid ;
    rdfs:label "How many people study at universities in California?" ;
    lsqv:hasStructuralFeatures [ ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX dbr: <http://dbpedia.org/resource/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT SUM(?numStudents) WHERE {
  ?university rdf:type dbo:University .
  ?university dbo:state dbr:California .
  ?university dbo:numberOfStudents ?numStudents .
}
""" ;
    dct:created "2026-07-22T15:16:26+00:00"^^xsd:dateTime ;
    dct:modified "2026-07-22T15:16:26+00:00"^^xsd:dateTime .

