            lsqv:projectVarCount 1 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:Count,
                lsqv:GroupBy,
                lsqv:Groupby,
                lsqv:OrderBy,
                lsqv:Orderby,
                lsqv:Sample,
                lsqv:Select ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX dbo: <http://dbpedia.org/ontology/>

SELECT ?country WHERE {
  ?university a dbo:University .
  ?university dbo:country ?country .
}
GROUP BY ?country
ORDER BY ASC(COUNT(?university))
""" ;
