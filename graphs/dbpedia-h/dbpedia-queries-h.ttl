:96 a lsqv:Query,
        qat:AggregateEnumeration,
        qat:Factoid ;
    rdfs:label "List all countries, starting with those who have the least amount of universities." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:Count,
                lsqv:GroupBy,
                lsqv:Groupby,
                lsqv:OrderBy,
                lsqv:Orderby,
                lsqv:Sample,
                lsqv:Select ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX dbo: <http://dbpedia.org/ontology/>

SELECT ?country WHERE {
  ?university a dbo:20340483752879079365 .
  ?university dbo:71702862340875497676 ?country .
}
GROUP BY ?country
ORDER BY ASC(COUNT(?university))
""" ;
    dct:created "2026-07-22T15:16:26+00:00"^^xsd:dateTime ;
    dct:modified "2026-07-22T15:16:26+00:00"^^xsd:dateTime .

