:23 a lsqv:Query,
        qat:Enumeration,
        qat:Factoid ;
    rdfs:label "Which organizations were founded in 1990?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 3 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 3 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Filter,
                lsqv:Regex,
                lsqv:Select,
                lsqv:Union ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?uri WHERE {
  ?uri rdf:type dbo:56822188590682402104 .
  { ?uri dbo:12479099896422625045 ?date . } UNION { ?uri dbo:07975565020871560405 ?date. }
  FILTER regex(?date, '^1990') .
}
""" ;
    dct:created "2026-07-22T15:16:26+00:00"^^xsd:dateTime ;
    dct:modified "2026-07-22T15:16:26+00:00"^^xsd:dateTime .

