    lsqv:resultCount 1 ;
    lsqv:text """SELECT COUNT(DISTINCT ?author) WHERE {  
  ?x <http://dbpedia.org/ontology/03272781667217271140> <http://dbpedia.org/resource/19654883412715583056> .  
  ?x <http://dbpedia.org/ontology/03019987180435018039> ?author .
}
""" ;
