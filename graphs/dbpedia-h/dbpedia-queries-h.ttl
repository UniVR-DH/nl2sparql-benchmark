:2 a lsqv:Query,
        qat:Factoid,
        qat:LimitedRankedListing ;
    rdfs:label "What are the 10 most populated countries?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Limit,
                lsqv:OrderBy,
                lsqv:Orderby,
                lsqv:Select ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?country WHERE {
  ?country rdf:type dbo:23942714519161596693 .
  ?country dbo:02447517036979252274 ?population .
} ORDER BY DESC(?population) LIMIT 10
""" ;
    dct:created "2026-07-22T15:16:26+00:00"^^xsd:dateTime ;
    dct:modified "2026-07-22T15:16:26+00:00"^^xsd:dateTime .

