:80 a lsqv:Query,
        qat:AggregateEnumeration,
        qat:Factoid,
        qat:LimitedRankedListing ;
    rdfs:label "List the 10 countries with most cities." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:Count,
                lsqv:GroupBy,
                lsqv:Groupby,
                lsqv:Limit,
                lsqv:OrderBy,
                lsqv:Orderby,
                lsqv:Sample,
                lsqv:Select ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX dbo: <http://dbpedia.org/ontology/>
SELECT ?country WHERE {
  ?city a dbo:15793910748485834833 .
  ?city dbo:71702862340875497676 ?country .
}
GROUP BY ?country
ORDER BY DESC(COUNT(?city))
LIMIT 10
""" ;
    dct:created "2026-07-22T15:16:26+00:00"^^xsd:dateTime ;
    dct:modified "2026-07-22T15:16:26+00:00"^^xsd:dateTime .

