{
  "@context": {
  "@base": "http://dbpedia-h.org/dataset/",
  "@vocab": "https://mlcommons.org/croissant/",
  "@language": "en",
  "dct": "http://purl.org/dc/terms/",
  "lsqv": "http://lsq.aksw.org/vocab#",
  "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
  "sc": "https://schema.org/",
  "sp": "http://spinrdf.org/sp#"
  },
  "@type": "sc:Dataset",
  "@id": "http://dbpedia-h.org/dataset",
  "sc:name": "Global and Unified Access to Knowledge Graphs",
  "sc:description": "Hashed DBpedia is a crowd-sourced community effort to extract structured content from the information created in various Wikimedia projects.",
  "sc:license": "https://creativecommons.org/licenses/by/4.0/",
  "sc:datePublished": "2026-07-24",
  "sc:version": "1.0",
  "sc:citation": "Benelli, B., Balasooriya, I., Marastoni, N., QUINTARELLI, E., & Lissandrini, M. (2026). Supplementary material for FAULT: Failure Analysis and Understanding for Language-to-SPARQL Testing [Data set]. Zenodo. https://doi.org/10.5281/zenodo.20073837",

  "distribution": [
    { "@type": "FileObject", "@id": "entrypoint", "name": "dbpedia-h.ttl", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "entrypoint-graph", "name": "dbpedia-h.graph", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "instances", "name": "dbpedia-data-h.ttl", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "instances-graph", "name": "dbpedia-data-h.graph", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "shapes", "name": "dbpedia-data-shapes-h.ttl", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "shapes-graph", "name": "dbpedia-data-shapes-h.graph", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "examples", "name": "dbpedia-examples-h.ttl", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "examples-graph", "name": "dbpedia-examples-h.graph", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "queries", "name": "dbpedia-queries-h.ttl", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "queries-graph", "name": "dbpedia-queries-h.graph", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "void", "name": "dbpedia-void-h.ttl", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "void-graph", "name": "dbpedia-void-h.graph", "contentUrl": "https://zenodo.org/records/20073836", "encodingFormat": "application/octet-stream" }
  ],

  "recordSet": [
    {
      "@type": "RecordSet",
      "@id": "query-benchmark",
      "name": "Query Benchmark",
      "field": [
        {
          "@type": "Field",
          "@id": "label",
          "name": "rdfs:label",
          "dataType": "Text",
          "source": {
            "fileObject": {"@id": "queries" },
            "extract": {
              "@type": "sp:TriplePattern",
              "sp:subject": "?s",
              "sp:predicate": "rdfs:label",
              "sp:object": "?l",
              "column": "?l"
            }
          }
        },
        {
          "@type": "Field",
          "@id": "text",
          "name": "lsqv:text",
          "dataType": "Text",
          "source": {
            "fileObject": {"@id": "queries" },
            "extract": {
              "@type": "sp:TriplePattern",
              "sp:subject": "?s",
              "sp:predicate": "lsqv:text",
              "sp:object": "?q",
              "column": "?q"
            }
          }
        }
      ]
    }
  ]
}