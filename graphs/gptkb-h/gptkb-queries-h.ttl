    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>
 SELECT ?employee
        WHERE {
          gptkb:5709647119 gptkbp:9438107427 ?employee .
        }
ORDER BY ASC (?employee )
        LIMIT 5""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:5709647119,
        gptkbp:9438107427 .

:25 a lsqv:Query,
        qat1:AggregateEnumeration,
        qat1:Comparative ;
    rdfs:label "Which person is associated with the maximum number of notable works in the dataset?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 4 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Filter,
                lsqv:GroupBy,
                lsqv:Select,
                lsqv:SubQuery ] ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>

        SELECT ?person ?workCount
        WHERE {
          {
            SELECT ?person (COUNT(DISTINCT ?work) AS ?workCount)
            WHERE {
              ?person gptkbp:5312865579 gptkb:8670707699 ;
                      gptkbp:4277969302 ?work .
            }
            GROUP BY ?person
          }
          {
            SELECT (MAX(?c_inner) AS ?maxCount)
            WHERE {
              SELECT ?p_inner
                     (COUNT(DISTINCT ?w_inner) AS ?c_inner)
              WHERE {
                ?p_inner gptkbp:5312865579 gptkb:8670707699 ;
                         gptkbp:4277969302 ?w_inner .
              }
              GROUP BY ?p_inner
            }
          }
          FILTER(?workCount = ?maxCount)
        }""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:8670707699,
        gptkbp:5312865579,
        gptkbp:4277969302 .

