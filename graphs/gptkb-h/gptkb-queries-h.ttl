:16 a lsqv:Query,
        qat:Confirmation ;
    rdfs:label "Are there System Managers with problem solving ability?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 0 ;
            lsqv:tpCount 1 ;
            lsqv:usesFeature lsqv:Ask,
                lsqv:Filter,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>

ASK {
  gptkb:2333514137 gptkbp:1670736112 ?ability .
  FILTER(
    CONTAINS(LCASE(STR(?ability)), "problem solving")
  )
}""" ;
