:9 a lsqv:Query,
        qat1:Enumeration,
        qat1:RankedListing,
        qat:Enumeration,
        qat:RankedListing ;
    rdfs:label "Which persons work in chemistry or physics, either by their field of work or by their occupation, have received at least one award, and are members of at least one organisation? Return each person together with their field, award, and organisation." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 3 ;
            lsqv:projectVarCount 4 ;
            lsqv:tpCount 5 ;
            lsqv:usesFeature lsqv:Bind,
                lsqv:Distinct,
                lsqv:Filter,
                lsqv:Optional,
                lsqv:OrderBy,
                lsqv:Select,
                lsqv:TriplePattern,
                lsqv:Union ] ;
    lsqv:text """PREFIX gptkbp: <https://gptkb.org/prop/>
PREFIX gptkb: <https://gptkb.org/entity/>

SELECT DISTINCT ?person ?field ?award ?organisation
WHERE {
  ?person gptkbp:5312865579 gptkb:8670707699 ;
          gptkbp:4258876171 ?award ;
          gptkbp:9741577034 ?organisation .
  {
    ?person gptkbp:2126305219 ?field .
    FILTER(CONTAINS(LCASE(STR(?field)), "chemistry")
        || CONTAINS(LCASE(STR(?field)), "physics"))
  }
  UNION
  {
    ?person gptkbp:6127890684 ?occ .
    FILTER(?occ = gptkb:9166019976
        || ?occ = gptkb:2558630743)
    BIND(STR(?occ) AS ?field)
  }
}
ORDER BY ?person""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:9166019976,
        gptkb:8670707699,
        gptkb:2558630743,
        gptkbp:4258876171,
        gptkbp:2126305219,
        gptkbp:5312865579,
        gptkbp:9741577034,
        gptkbp:6127890684 .

