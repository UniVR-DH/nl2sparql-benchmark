:15 a lsqv:Query ;
  rdfs:label "What is the cheapest Encoder we can get from a french or german supplier?" ;
  dct:created "2026-03-30T16:02:31.732247Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.732247Z"^^xsd:dateTime ;
  lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE {
  ?result pv:5e848e <http://ld.company.org/prod-instances/f936ad> .
  ?result pv:e462e7 ?priceR .
  ?priceR pv:af5cae ?price .
  ?result pv:1bade2 ?supplier .
  ?supplier pv:2f6a8b ?country .
  FILTER ( (?country = "France") ||  (?country = "Germany") )
}
ORDER BY ASC(?price)
LIMIT 1""" ;
  lsqv:hasStructuralFeatures _:sf15 ;
  lsqv:resultCount "1"^^xsd:integer ;
  dct:subject pv:2f6a8b, pv:af5cae, pv:5e848e, pv:1bade2, pv:e462e7,
  <http://ld.company.org/prod-instances/f936ad> .

