  ?result pv:5e848e <http://ld.company.org/prod-instances/c802ca> .
  ?result pv:4811a9 ?width_mm .
  ?result pv:807b0b ?depth_mm .
  ?result pv:9eefc0 ?height_mm .
  BIND(?width_mm * ?depth_mm * ?height_mm as ?volume)
}
