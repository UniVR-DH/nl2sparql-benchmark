  dct:created "2026-03-30T16:02:31.732556Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.732556Z"^^xsd:dateTime ;
  lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
