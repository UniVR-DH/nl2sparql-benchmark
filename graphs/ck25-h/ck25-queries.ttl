:35 a lsqv:Query ;
  rdfs:label "For every product, list what other products it is compatible with and the price differences between both." ;
  dct:created "2026-03-30T16:02:31.733107Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733107Z"^^xsd:dateTime ;
  lsqv:text """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv:    <http://ld.company.org/prod-vocab/>

SELECT ?prod ?compatible (?prodAmount - ?compatibleAmount AS ?priceDiff)
WHERE {
  ?prodClass rdfs:subClassOf* pv:217433 .
  ?prod a ?prodClass ;
    pv:a6d551 ?compatible .
  ?prod pv:e462e7/pv:af5cae ?prodAmount ;
    pv:e462e7/pv:d7f276 "EUR" .
  ?compatible pv:e462e7/pv:af5cae ?compatibleAmount ;
    pv:e462e7/pv:d7f276 "EUR" .
}""" ;
