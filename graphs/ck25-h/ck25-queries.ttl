:25 a lsqv:Query ;
  rdfs:label "Which coil has the highest density?" ;
  dct:created "2026-03-30T16:02:31.732600Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.732600Z"^^xsd:dateTime ;
  lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>
SELECT DISTINCT ?result
WHERE {
  ?result pv:5e848e <http://ld.company.org/prod-instances/506e75> .
  ?result pv:4811a9 ?width_mm .
  ?result pv:807b0b ?depth_mm .
  ?result pv:9eefc0 ?height_mm .
  ?result pv:c4bb1c ?weight_g .
  BIND(?width_mm * ?depth_mm * ?height_mm / 1000000000 AS ?volume_m3)
  BIND(?weight_g / 1000 AS ?weight_kg)
  BIND(?weight_kg / ?volume_m3 AS ?density)
}
ORDER BY DESC(?density)
LIMIT 1""" ;
  lsqv:hasStructuralFeatures _:sf25 ;
  lsqv:resultCount "0"^^xsd:integer ;
  dct:subject pv:807b0b, pv:5e848e, pv:9eefc0, pv:c4bb1c, pv:4811a9,
  <http://ld.company.org/prod-instances/506e75> .

_:sf25 a lsqv:StructuralFeatures ;
