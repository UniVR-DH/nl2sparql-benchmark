:37 a lsqv:Query ;
  rdfs:label "For each Bill of Material, how many parts does it contain and what is the total material quantity — show me only those BOMs exceeding 600 total items and order them descending." ;
  dct:created "2026-03-30T16:02:31.733199Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733199Z"^^xsd:dateTime ;
  lsqv:text """PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?bom (COUNT(?part) AS ?partCount) (SUM(?qty) AS ?totalQty)
WHERE {
  ?bom a pv:93a553 ;
    pv:0607c7 ?part .
  ?part pv:e90f57 ?qty_ .
  BIND(xsd:int(?qty_) AS ?qty)
}
GROUP BY ?bom
HAVING (SUM(?qty) > 600)
ORDER BY DESC(SUM(?qty))""" ;
  lsqv:hasStructuralFeatures _:sf37 ;
  lsqv:resultCount "7"^^xsd:integer ;
  dct:subject pv:93a553, pv:0607c7,
  pv:e90f57 .

_:sf37 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Select, lsqv:GroupBy, lsqv:Having, lsqv:Aggregators, lsqv:agg-count, lsqv:fn-gt, lsqv:TriplePattern ;
  lsqv:projectVarCount "3"^^xsd:integer ;
  lsqv:tpCount "3"^^xsd:integer ;
  lsqv:bgpCount "1"^^xsd:integer ;
  dct:subject pv:93a553, pv:0607c7, pv:e90f57 .

:38 a lsqv:Query ;
  rdfs:label "I want to update my contact list, for each Employee give me name, email, phone number and the department they belong to as well as their direct report." ;
  dct:created "2026-03-30T16:02:31.733243Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733243Z"^^xsd:dateTime ;
  lsqv:text """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?name ?email ?phone ?dept ?manager
WHERE {
  ?agentClass rdfs:subClassOf* pv:f79b36 .
  ?empl a ?agentClass ;
    pv:704fde ?name .
  OPTIONAL { ?empl pv:e1dbec ?email . }
  OPTIONAL { ?empl pv:caf9e1 ?phone . }
  OPTIONAL { ?empl pv:8c4b73/pv:704fde ?dept . }
  OPTIONAL { ?empl pv:f6909e/pv:704fde ?manager . }
}""" ;
  lsqv:hasStructuralFeatures _:sf38 ;
  lsqv:resultCount "106"^^xsd:integer ;
  dct:subject pv:f79b36, pv:e1dbec, pv:f6909e, pv:8c4b73, pv:704fde,
  pv:caf9e1 .

_:sf38 a lsqv:StructuralFeatures ;
