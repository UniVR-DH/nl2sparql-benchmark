  ?hw a pv:1b4d3f ;
  pv:e462e7/pv:af5cae ?price ;
    pv:e462e7/pv:d7f276 "EUR" ;
    pv:1bade2 ?sup .
}
ORDER BY DESC(?price)
LIMIT 5 OFFSET 5""" ;
