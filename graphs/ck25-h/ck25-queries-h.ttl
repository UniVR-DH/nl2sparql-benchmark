:41 a lsqv:Query ;
  rdfs:label "For each manager, what percentage of their entire team work in the same department as the manager?" ;
  dct:created "2026-03-30T16:02:31.733366Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733366Z"^^xsd:dateTime ;
  lsqv:text """PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?m ?name (?deptTeam / ?fullteam * 100 AS ?pct)
WHERE {

  ?m pv:704fde ?name .

  { # full team
    SELECT ?m (COUNT(*) AS ?fullteam) WHERE {
      ?e pv:f6909e ?m .
    } GROUP BY ?m
  }

  { # team in same dept
    SELECT ?m (COUNT(*) AS ?deptTeam) WHERE {
      ?m pv:8c4b73 ?dept .
      ?e pv:f6909e ?m .
      ?e pv:8c4b73 ?dept .
    } GROUP BY ?m
  }
}""" ;
  lsqv:hasStructuralFeatures _:sf41 ;
  lsqv:resultCount "6"^^xsd:integer ;
  dct:subject pv:f6909e, pv:8c4b73,
  pv:704fde .

_:sf41 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Select, lsqv:GroupBy, lsqv:Aggregators, lsqv:agg-count, lsqv:TriplePattern ;
  lsqv:projectVarCount "2"^^xsd:integer ;
  lsqv:tpCount "5"^^xsd:integer ;
  lsqv:bgpCount "1"^^xsd:integer ;
  dct:subject pv:f6909e, pv:8c4b73, pv:704fde .

:42 a lsqv:Query ;
  rdfs:label "Which Bill-of-Material has the highest average unit cost of its hardware parts, and what is that average?" ;
  dct:created "2026-03-30T16:02:31.733417Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733417Z"^^xsd:dateTime ;
  lsqv:text """PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prodi: <http://ld.company.org/prod-instances/>
PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?bom (ROUND(AVG(?spst / ?sq) * 100) / 100 AS ?avgUnitCost)
WHERE {
  {
    SELECT ?bom (SUM(?partSubTotal) AS ?spst) (SUM(xsd:int(?quant)) AS ?sq)
    WHERE {
      ?bom a pv:93a553 ;
        pv:0607c7 ?part .
      ?part pv:e90f57 ?quant .
      ?part pv:d25624/pv:e462e7/pv:af5cae ?amount .
      ?part pv:d25624/pv:e462e7/pv:d7f276 "EUR" .
      BIND(xsd:int(?quant) * ?amount AS ?partSubTotal)
    }
    GROUP BY ?bom
  }
}
GROUP BY ?bom
ORDER BY DESC(?avgUnitCost)
LIMIT 1""" ;
  lsqv:hasStructuralFeatures _:sf42 ;
  lsqv:resultCount "1"^^xsd:integer ;
  dct:subject pv:93a553, pv:af5cae, pv:d7f276, pv:0607c7, pv:d25624, pv:e462e7,
  pv:e90f57 .

_:sf42 a lsqv:StructuralFeatures ;
  lsqv:usesFeature lsqv:Select, lsqv:GroupBy, lsqv:TriplePattern ;
  lsqv:projectVarCount "2"^^xsd:integer ;
  lsqv:tpCount "5"^^xsd:integer ;
  lsqv:bgpCount "1"^^xsd:integer ;
  dct:subject pv:93a553, pv:af5cae, pv:d7f276, pv:0607c7, pv:d25624, pv:e462e7, pv:e90f57 .

:43 a lsqv:Query ;
  rdfs:label "Show me any cycles of product compatibility — i.e. product A says it's compatible with B, and B says it's compatible with A (mutual pairs)." ;
  dct:created "2026-03-30T16:02:31.733487Z"^^xsd:dateTime ;
  dct:modified "2026-03-30T16:02:31.733487Z"^^xsd:dateTime ;
  lsqv:text """PREFIX pv: <http://ld.company.org/prod-vocab/>

SELECT ?a ?b
WHERE {
  ?a pv:a6d551 ?b .
  FILTER (STR(?a) < STR(?b))
}""" ;
