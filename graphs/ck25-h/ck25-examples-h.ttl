ex:case_43_711b32da
  a sh:SPARQLExecutable,
    sh:SPARQLSelectExecutable;

  rdfs:comment "Find products with price higher than average in their category.";

  sh:select """
PREFIX pv: <http://ld.company.org/prod-vocab/> SELECT ?product ?price WHERE { ?product pv:426669 ?category ; pv:310044/pv:261910 ?price . { SELECT ?category (AVG(?amt) as ?avg) WHERE { ?p pv:426669 ?category ; pv:310044/pv:261910 ?amt } GROUP BY ?category } FILTER(?price > ?avg) }


""" ;

  schema:target <http://157.27.26.146:7001/> .

