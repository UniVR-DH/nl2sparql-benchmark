{
  "@context": {
    "@vocab": "https://mlcommons.org/croissant/",
    "dct": "http://purl.org/dc/terms/",
    "lsqv": "http://lsq.aksw.org/vocab#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "http://schema.org/",
    "sc": "http://schema.org/",
    "sp": "http://spinrdf.org/sp#"
  },
  "@type": "Dataset",
  "@id": "https://text2sparql.aksw.org/2025/corporate/",
  "name": "TEXT2SPARQL Benchmark — Corporate Knowledge Graph",
  "description": "RDF benchmark dataset for text-to-SPARQL systems, structured as a VoID dataset with modular imports for instances, vocabularies, shapes, examples, and query workloads.",
  "license": "https://creativecommons.org/licenses/by/4.0/",

  "distribution": [
    { "@type": "FileObject", "@id": "entrypoint", "name": "ck25-h.ttl", "contentUrl": "ck25-h.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "entrypoint-graph", "name": "ck25-h.graph", "contentUrl": "ck25-h.graph", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "instances", "name": "ck25-data-instances-h.ttl", "contentUrl": "ck25-data-instances-h.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "instances-graph", "name": "ck25-data-instances-h.graph", "contentUrl": "ck25-data-instances-h.graph", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "vocab", "name": "ck25-data-vocab-h.ttl", "contentUrl": "ck25-data-vocab-h.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "vocab-graph", "name": "ck25-data-vocab-h.graph", "contentUrl": "ck25-data-vocab-h.graph", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "shapes", "name": "ck25-data-shapes-h.ttl", "contentUrl": "ck25-data-shapes-h.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "shapes-graph", "name": "ck25-data-shapes-h.graph", "contentUrl": "ck25-data-shapes-h.graph", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "examples", "name": "ck25-examples-h.ttl", "contentUrl": "ck25-examples-h.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "examples-graph", "name": "ck25-examples-h.graph", "contentUrl": "ck25-examples-h.graph", "encodingFormat": "application/octet-stream" },

    { "@type": "FileObject", "@id": "queries", "name": "ck25-queries-h.ttl", "contentUrl": "ck25-queries-h.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "queries-graph", "name": "ck25-queries-h.graph", "contentUrl": "ck25-queries-h.graph", "encodingFormat": "application/octet-stream" },
    
    { "@type": "FileObject", "@id": "void", "name": "ck25-void-h.ttl", "contentUrl": "ck25-void-h.ttl", "encodingFormat": "text/turtle" },
    { "@type": "FileObject", "@id": "void-graph", "name": "ck25-void-h.graph", "contentUrl": "ck25-void-h.graph", "encodingFormat": "application/octet-stream" }
  ],

  "recordSet": [
    {
      "@type": "RecordSet",
      "name": "Query Benchmark",
      "field": [
        {
          "@type": "Field",
          "name": "rdfs:label",
          "dataType": "sc:Text",
          "source": {
            "fileObject": "queries",
            "extract": {
              "@type": "sp:TriplePattern",
              "sp:subject": "?s",
              "sp:predicate": "rdfs:label",
              "sp:object": "?l",
              "column": "?l"
            }
          }
        },
        {
          "@type": "Field",
          "name": "lsqv:text",
          "dataType": "sc:Text",
          "source": {
            "fileObject": "queries",
            "extract": {
              "@type": "sp:TriplePattern",
              "sp:subject": "?s",
              "sp:predicate": "lsqv:text",
              "sp:object": "?q",
              "column": "?q"
            }
          }
        }
      ]
    }
  ]
}