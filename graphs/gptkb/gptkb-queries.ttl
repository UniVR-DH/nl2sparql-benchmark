        gptkbp:headquarters .

:6 a lsqv:Query,
        qat1:Enumeration,
        qat:Enumeration ;
    rdfs:label "Which entities are directly connected to Isaac Newton, either as people influenced by him or as entities that influenced him?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Select,
                lsqv:TriplePattern,
                lsqv:Union ] ;
    lsqv:text """PREFIX gptkbp: <https://gptkb.org/prop/>
PREFIX gptkb: <https://gptkb.org/entity/>

SELECT DISTINCT ?o
WHERE {
  {
    gptkb:Isaac_Newton gptkbp:influenced ?o .
  }
  UNION
  {
    ?o gptkbp:influenced gptkb:Isaac_Newton .
  }
}""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:Isaac_Newton,
        gptkbp:influenced .

:7 a lsqv:Query,
        qat1:Aggregation,
        qat:Aggregation ;
    rdfs:label "How many people have a nationality that is either German or French?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 1 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Select,
                lsqv:TriplePattern,
                lsqv:Values,
                lsqv:agg-count ] ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>

SELECT (COUNT(DISTINCT ?person) AS ?count)
WHERE {
  ?person gptkbp:nationality ?citizenship .
  VALUES ?citizenship {
    gptkb:German
    gptkb:French
  }
}""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:French,
        gptkb:German,
        gptkbp:nationality .

:8 a lsqv:Query,
        qat1:Enumeration,
        qat:Enumeration ;
