:22 a lsqv:Query,
        qat:Sampling ;
    rdfs:label "Show me 5 notable employees of Bolt Beranek and Newman." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 1 ;
            lsqv:usesFeature lsqv:Limit,
                lsqv:Select ] ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
    PREFIX gptkbp: <https://gptkb.org/prop/>
    SELECT ?employee
    WHERE {
          gptkb:Bolt_Beranek_and_Newman gptkbp:notableEmployee ?employee .
        }
        LIMIT 5""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:Bolt_Beranek_and_Newman,
        gptkbp:notableEmployee .

:23 a lsqv:Query,
        qat1:AggregateEnumeration ;
    rdfs:label "For each person, how many distinct organisations are they a member of?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:GroupBy,
                lsqv:Having,
                lsqv:OrderBy,
                lsqv:Select ] ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>
SELECT ?person (COUNT(DISTINCT ?org) AS ?orgCount)
        WHERE {
          ?person gptkbp:instanceOf gptkb:person ;
                  gptkbp:memberOf ?org .
        }
        GROUP BY ?person
        HAVING (COUNT(DISTINCT ?org) >= 2)
        ORDER BY DESC(?orgCount)""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:person,
    gptkbp:instanceOf,
        gptkbp:memberOf .

:24 a lsqv:Query,
        qat1:LimitedRankedListing ;
    rdfs:label "List the five notable employees of Bolt Beranek and Newman ordered alphabetically by IRI." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 1 ;
            lsqv:usesFeature lsqv:Limit,
                lsqv:OrderBy,
                lsqv:Select ] ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>
 SELECT ?employee
        WHERE {
          gptkb:Bolt_Beranek_and_Newman gptkbp:notableEmployee ?employee .
        }
ORDER BY ASC (?employee )
        LIMIT 5""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:Bolt_Beranek_and_Newman,
        gptkbp:notableEmployee .

:25 a lsqv:Query,
        qat1:AggregateEnumeration,
        qat1:Comparative ;
    rdfs:label "Which person is associated with the maximum number of notable works in the dataset?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 4 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Filter,
                lsqv:GroupBy,
                lsqv:Select,
                lsqv:SubQuery ] ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>

        SELECT ?person ?workCount
        WHERE {
          {
            SELECT ?person (COUNT(DISTINCT ?work) AS ?workCount)
            WHERE {
              ?person gptkbp:instanceOf gptkb:person ;
                      gptkbp:notableWork ?work .
            }
            GROUP BY ?person
          }
          {
            SELECT (MAX(?c_inner) AS ?maxCount)
            WHERE {
              SELECT ?p_inner
                     (COUNT(DISTINCT ?w_inner) AS ?c_inner)
              WHERE {
                ?p_inner gptkbp:instanceOf gptkb:person ;
                         gptkbp:notableWork ?w_inner .
              }
              GROUP BY ?p_inner
            }
          }
          FILTER(?workCount = ?maxCount)
        }""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:person,
        gptkbp:instanceOf,
        gptkbp:notableWork .

