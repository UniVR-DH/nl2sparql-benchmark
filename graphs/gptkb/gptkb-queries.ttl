:5 a lsqv:Query,
        qat1:Factoid,
        qat:Factoid ;
    rdfs:label "Which entities are headquartered in Mountain View, California?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 1 ;
            lsqv:usesFeature lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:text """PREFIX gptkbp: <https://gptkb.org/prop/>
PREFIX gptkb: <https://gptkb.org/entity/>

SELECT ?s
WHERE {
  ?s gptkbp:headquarters gptkb:Mountain_View%2C_California .
}""" ;
