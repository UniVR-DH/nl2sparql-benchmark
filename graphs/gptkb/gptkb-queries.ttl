                lsqv:TriplePattern ] ;
    lsqv:text """PREFIX gptkbp: <https://gptkb.org/prop/>
PREFIX gptkb: <https://gptkb.org/entity/>

SELECT DISTINCT ?person WHERE {
  ?person gptkbp:awardReceived gptkb:Academy_Award_for_Best_Director .
