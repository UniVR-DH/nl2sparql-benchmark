    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:Academy_Award_for_Best_Director,
        gptkb:Golden_Globe_Award_for_Best_Director,
        gptkbp:awardReceived .

:16 a lsqv:Query,
        qat:Confirmation ;
    rdfs:label "Are there System Managers with problem solving ability?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 0 ;
            lsqv:tpCount 1 ;
            lsqv:usesFeature lsqv:Ask,
                lsqv:Filter,
                lsqv:TriplePattern ] ;
    lsqv:resultCount 1 ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>

ASK {
  gptkb:System_Manager gptkbp:abilities ?ability .
  FILTER(
    CONTAINS(LCASE(STR(?ability)), "problem solving")
  )
}""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:System_Manager,
        gptkbp:abilities .

:17 a lsqv:Query,
        qat:Enumeration ;
    rdfs:label "Which persons were members of the National Academy of Sciences and received at least one award? Return each person together with their awards." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 3 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:text """PREFIX gptkbp: <https://gptkb.org/prop/>
PREFIX gptkb: <https://gptkb.org/entity/>

SELECT DISTINCT ?person ?award
WHERE {
  ?person gptkbp:instanceOf gptkb:person ;
          gptkbp:memberOf gptkb:National_Academy_of_Sciences ;
          gptkbp:awardReceived ?award .
}""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:National_Academy_of_Sciences,
        gptkb:person,
        gptkbp:awardReceived,
        gptkbp:instanceOf,
        gptkbp:memberOf .

:18 a lsqv:Query,
        qat:Aggregation,
        qat:Comparative ;
    rdfs:label "Who served the longest term as president of an institution? Return the person, the institution, and the length of their term." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 3 ;
            lsqv:tpCount 8 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Bind,
                lsqv:Filter,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern,
                lsqv:agg-count ] ;
    lsqv:text """PREFIX gptkbp: <https://gptkb.org/prop/>
PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?person ?institution ?years
WHERE {
  {
    SELECT ?person ?institution ((xsd:integer(?termEnd) - xsd:integer(?termStart)) AS ?years)
    WHERE {
      ?person gptkbp:instanceOf gptkb:person ;
              gptkbp:president ?institution ;
              gptkbp:termStart ?termStart ;
              gptkbp:termEnd ?termEnd .
    }
  }

  {
    SELECT (MAX(?termLength) AS ?maxYears)
    WHERE {
      ?p gptkbp:instanceOf gptkb:person ;
         gptkbp:president ?inst ;
         gptkbp:termStart ?ts ;
         gptkbp:termEnd ?te .
      BIND((xsd:integer(?te) - xsd:integer(?ts)) AS ?termLength)
    }
  }

  FILTER(?years = ?maxYears)
}""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:person,
        gptkbp:instanceOf,
        gptkbp:president,
        gptkbp:termEnd,
        gptkbp:termStart .

:19 a lsqv:Query,
        qat:AggregateEnumeration ;
    rdfs:label "Which operas have more than 1 librettist?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 1 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:GroupBy,
                lsqv:Having,
                lsqv:Select,
                lsqv:TriplePattern,
                lsqv:agg-count,
                lsqv:fn-gt ] ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>

SELECT ?opera WHERE {
  ?opera gptkbp:librettist ?librettist .
}
GROUP BY ?opera
HAVING (COUNT(?librettist) > 1)""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:opera,
        gptkbp:librettist .

:2 a lsqv:Query,
        qat:Aggregation ;
    rdfs:label "Which mountain(s) in Italy have the maximum elevation, and what are their IRIs, names and elevations?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 3 ;
            lsqv:projectVarCount 3 ;
            lsqv:tpCount 7 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Filter,
                lsqv:Optional,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern ] ;
    lsqv:text """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX gptkbp: <https://gptkb.org/prop/>
PREFIX gptkb: <https://gptkb.org/entity/>

SELECT ?mountain ?mountainLabel ?elev
WHERE {
  ?mountain gptkbp:instanceOf gptkb:mountain .
  ?mountain gptkbp:country gptkb:Italy .
  ?mountain gptkbp:elevation ?elev .

  OPTIONAL { ?mountain rdfs:label ?mountainLabel }

  {
    SELECT (MAX(xsd:decimal(REPLACE(str(?e), "[^0-9\\\\.\\\\-]", ""))) AS ?maxElev)
    WHERE {
      ?m gptkbp:instanceOf gptkb:mountain .
      ?m gptkbp:country gptkb:Italy .
      ?m gptkbp:elevation ?e .
    }
  }

  FILTER (
    xsd:decimal(REPLACE(str(?elev), "[^0-9\\\\.\\\\-]", "")) = ?maxElev
  )
}""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:Italy,
        gptkb:mountain,
        gptkbp:country,
        gptkbp:elevation,
        gptkbp:instanceOf .

:20 a lsqv:Query,
        qat:AggregateEnumeration ;
    rdfs:label "Who are the people that have been librettist for more than 7 operas?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 1 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:GroupBy,
                lsqv:Having,
                lsqv:Select,
                lsqv:TriplePattern,
                lsqv:agg-count,
                lsqv:fn-gt ] ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>

SELECT ?librettist WHERE {
  ?opera gptkbp:librettist ?librettist .
}
GROUP BY ?librettist
HAVING (COUNT(?opera) > 7)""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkbp:librettist .

