:1 a lsqv:Query,
        qat:Factoid ;
    rdfs:label "When was Mahatma Gandhi born?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 1 ;
            lsqv:usesFeature lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:text """PREFIX gptkbp: <https://gptkb.org/prop/>
PREFIX gptkb: <https://gptkb.org/entity/>
SELECT ?dob WHERE { gptkb:Mahatma_Gandhi gptkbp:birthDate ?dob . }""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:Mahatma_Gandhi,
        gptkbp:birthDate .

:10 a lsqv:Query,
        qat:Enumeration ;
    rdfs:label "Which artist won the Grammy Award for Best Male Pop Vocal Performance in 1999, and what was the winning work?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>

SELECT DISTINCT ?winner ?work WHERE {
  gptkb:Grammy_Award_for_Best_Male_Pop_Vocal_Performance_%281999%29
      gptkbp:winner ?winner ;
      gptkbp:winningWork ?work .
}""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:Grammy_Award_for_Best_Male_Pop_Vocal_Performance_%281999%29,
        gptkbp:winner,
        gptkbp:winningWork .

:11 a lsqv:Query,
        qat:CounterFactualIdentification,
        qat:Enumeration ;
    rdfs:label "Which persons do not have a recorded birth place in the dataset?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 2 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:NotExists,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:text """PREFIX gptkbp: <https://gptkb.org/prop/>
PREFIX gptkb: <https://gptkb.org/entity/>

SELECT DISTINCT ?person
WHERE {
  ?person gptkbp:instanceOf gptkb:person .
  FILTER NOT EXISTS {
    ?person gptkbp:birthPlace ?birthPlace .
  }
}""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:person,
        gptkbp:birthPlace,
        gptkbp:instanceOf .

:12 a lsqv:Query,
        qat:AggregateEnumeration,
        qat:Comparative ;
    rdfs:label "Which persons have received the highest number of awards? Return each person together with their award count and name." ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 3 ;
            lsqv:projectVarCount 3 ;
            lsqv:tpCount 5 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Filter,
                lsqv:GroupBy,
                lsqv:Optional,
                lsqv:OrderBy,
                lsqv:Select,
                lsqv:SubQuery,
                lsqv:TriplePattern,
                lsqv:agg-count ] ;
    lsqv:text """PREFIX gptkbp: <https://gptkb.org/prop/>
PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?person ?personName ?awardCount
WHERE {
  {
    SELECT ?person (COUNT(DISTINCT ?award) AS ?awardCount)
    WHERE {
      ?person gptkbp:instanceOf gptkb:person ;
              gptkbp:awardReceived ?award .
    }
    GROUP BY ?person
  }

  {
    SELECT (MAX(?ac) AS ?maxAwardCount)
    WHERE {
      SELECT ?person (COUNT(DISTINCT ?award) AS ?ac)
      WHERE {
        ?person gptkbp:instanceOf gptkb:person ;
                gptkbp:awardReceived ?award .
      }
      GROUP BY ?person
    }
  }

  OPTIONAL {
    ?person rdfs:label ?personName .
    FILTER(LANG(?personName) = "en")
  }

  FILTER(?awardCount = ?maxAwardCount)
}
ORDER BY ?person""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:person,
        gptkbp:awardReceived,
        gptkbp:instanceOf .

:13 a lsqv:Query,
        qat:AggregateEnumeration ;
    rdfs:label "How many people from each country have received both a Grammy Award and an Emmy Award?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 3 ;
            lsqv:usesFeature lsqv:Aggregators,
                lsqv:Distinct,
                lsqv:GroupBy,
                lsqv:Select,
                lsqv:TriplePattern,
                lsqv:agg-count ] ;
    lsqv:text """PREFIX gptkb: <https://gptkb.org/entity/>
PREFIX gptkbp: <https://gptkb.org/prop/>

SELECT ?country (COUNT(DISTINCT ?person) AS ?count)
WHERE {
  ?person gptkbp:awardReceived gptkb:Emmy_Award ;
          gptkbp:awardReceived gptkb:Grammy_Award ;
          gptkbp:nationality ?country .
}
GROUP BY ?country""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkb:Emmy_Award,
        gptkb:Grammy_Award,
        gptkbp:awardReceived,
        gptkbp:nationality .

:14 a lsqv:Query,
        qat:Enumeration ;
    rdfs:label "Which pairs of awards have been received by the same person?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 2 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Distinct,
                lsqv:Filter,
                lsqv:Select,
                lsqv:TriplePattern ] ;
    lsqv:text """PREFIX gptkbp: <https://gptkb.org/prop/>

SELECT DISTINCT ?a1 ?a2
WHERE {
  ?p gptkbp:awardReceived ?a1 .
  ?p gptkbp:awardReceived ?a2 .
  FILTER (STR(?a1) < STR(?a2))
}""" ;
    dct:created "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:modified "2026-05-06T00:00:00+00:00"^^xsd:dateTime ;
    dct:subject gptkbp:awardReceived .

:15 a lsqv:Query,
        qat:Enumeration ;
    rdfs:label "Who won both the Academy Award for Best Director and the Golden Globe Award for Best Director?" ;
    lsqv:hasStructuralFeatures [ lsqv:bgpCount 1 ;
            lsqv:projectVarCount 1 ;
            lsqv:tpCount 2 ;
            lsqv:usesFeature lsqv:Distinct,
