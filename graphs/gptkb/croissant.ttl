PREFIX : <https://mlcommons.org/croissant/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX lsqv: <http://lsq.aksw.org/vocab#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sc: <https://schema.org/>
PREFIX sp: <http://spinrdf.org/sp#>

_:b0    :extract     _:b1;
        :fileObject  <https://text2sparql.aksw.org/2025/corporate/queries> .

_:b1    a             sp:TriplePattern;
        sp:object     "?l"@en;
        sp:predicate  "rdfs:label"@en;
        sp:subject    "?s"@en;
        :column       "?l"@en .

_:b2    :extract     _:b3;
        :fileObject  <https://text2sparql.aksw.org/2025/corporate/queries> .

_:b3    a             sp:TriplePattern;
        sp:object     "?q"@en;
        sp:predicate  "lsqv:text"@en;
        sp:subject    "?s"@en;
        :column       "?q"@en .

<https://text2sparql.aksw.org/2025/corporate/>
        a                 sc:Dataset;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/entrypoint>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/entrypoint-graph>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/instances>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/instances-graph>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/vocab>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/vocab-graph>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/shapes>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/shapes-graph>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/examples>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/examples-graph>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/queries>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/queries-graph>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/void>;
        :distribution     <https://text2sparql.aksw.org/2025/corporate/void-graph>;
        :recordSet        <https://text2sparql.aksw.org/2025/corporate/query-benchmark>;
        sc:citation       "ref"@en;
        sc:datePublished  "2026-05-07"@en;
        sc:description    "RDF benchmark dataset for text-to-SPARQL systems, structured as a VoID dataset with modular imports for instances, vocabularies, shapes, examples, and query workloads."@en;
        sc:license        "https://creativecommons.org/licenses/by/4.0/"@en;
        sc:name           "TEXT2SPARQL-Benchmark-GPTKB-Knowledge-Graph"@en;
        sc:version        "1.0"@en .

